# Build stage: resolve the locked dependency set (with the extras production
# needs) into a virtual environment. The runtime stage copies only that
# environment and the sources, so uv, pip caches and build tooling never ship
# in the image; a smaller image pulls and starts faster on small nodes.
FROM python:3.12-slim AS builder

WORKDIR /app

# Matches the uv series the CI workflows pin, so the lockfile is read identically.
RUN pip install --no-cache-dir "uv>=0.6,<0.7"

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Runtime dependencies resolve from uv.lock rather than a hand-copied list, so the
# image gets exactly what CI tested and cannot drift when a bound is widened.
# The aws extra (S3, SQS, SES, Textract) and the ingest extra (PDF and legacy
# Excel readers) are what production settings require; the anthropic extra is
# the Claude SDK behind GURU_MODEL_PROVIDER=anthropic, and the open-task extra
# is the Excel, PowerPoint, Word and chart libraries the open-task agent's
# sandbox offers (GURU_OPEN_TASK_ENABLED).
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project --extra aws --extra ingest --extra anthropic --extra open-task

FROM python:3.12-slim

WORKDIR /app

# The open-task sandbox starts model-written code in its own namespaces with
# unshare, which util-linux (essential in the Debian base) provides; the host
# must allow unprivileged user namespaces for GURU_OPEN_TASK_SANDBOX=isolated.

ENV PYTHONPATH=/app/apps/api \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/app/.venv/bin:$PATH

COPY --from=builder /app/.venv /app/.venv
COPY apps ./apps
COPY migrations ./migrations
COPY scripts ./scripts
RUN useradd --system --create-home --uid 10001 guruji \
    && mkdir -p /app/data/objects \
    && chown -R 10001:10001 /app/data
USER guruji

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

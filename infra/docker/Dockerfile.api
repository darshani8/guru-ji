FROM python:3.12-slim

WORKDIR /app

# Matches the uv series the CI workflows pin, so the lockfile is read identically.
RUN pip install --no-cache-dir "uv>=0.6,<0.7"

ENV PYTHONPATH=/app/apps/api \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH=/app/.venv/bin:$PATH

# Runtime dependencies resolve from uv.lock rather than a hand-copied list, so the
# image gets exactly what CI tested and cannot drift when a bound is widened.
# Copied ahead of the sources so the dependency layer caches across code changes.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY apps ./apps
COPY migrations ./migrations
COPY scripts ./scripts
RUN mkdir -p /app/data/objects && chown -R 10001:10001 /app/data

RUN useradd --system --create-home --uid 10001 guruji
USER guruji

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

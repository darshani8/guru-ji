# Local development defaults
GURU_APP_NAME=guru-ji-api
GURU_VERSION=0.1.0
GURU_ENVIRONMENT=development
GURU_DEV_BEARER_TOKEN=dev-token
CONTROL_DATABASE_URL=sqlite:///./data/guru_ji.db
GURU_ALLOWED_ORIGINS=http://localhost:5173
GURU_MAX_REQUEST_BYTES=1000000
GURU_REQUEST_TIMEOUT_SECONDS=30
GURU_RATE_LIMIT_REQUESTS=120
GURU_RATE_LIMIT_WINDOW_SECONDS=60

# Provider: deterministic is safe for local tests; Ollama/LiteLLM are explicit alternatives.
GURU_MODEL_PROVIDER=deterministic
# GURU_MODEL_PROVIDER=ollama
# GURU_OLLAMA_BASE_URL=http://127.0.0.1:11434
# GURU_OLLAMA_MODEL_ID=llama3.1:8b
# GURU_MODEL_PROVIDER=litellm
# GURU_LITELLM_MODEL_ID=openai/<model>
# GURU_LITELLM_BASE_URL=https://<approved-gateway>/v1
# GURU_LITELLM_API_KEY=<server-side-secret>
GURU_MODEL_TIMEOUT_SECONDS=8
GURU_MODEL_MAX_TOKENS=800

# Local demo source is on by default. For connector-stack testing, disable it
# and point the API at the authenticated connector service.
GURU_ENABLE_DEMO_DATA=true
# GURU_INSTITUTION_CONNECTOR_BASE_URL=http://127.0.0.1:8010
# GURU_INSTITUTION_CONNECTOR_SOURCE_ID=college_a_remote
# GURU_INSTITUTION_CONNECTOR_INSTITUTION_ID=college_a
# GURU_INSTITUTION_CONNECTOR_DISPLAY_NAME=College A connector
# GURU_INSTITUTION_CONNECTOR_AUTH_TOKEN=<server-side-secret>
# GURU_CONNECTOR_TIMEOUT_SECONDS=5
# GURU_CONNECTOR_MAX_RESPONSE_BYTES=1000000
# GURU_CONNECTOR_SCOPE_ATTESTATION_REQUIRED=true

# Policy decision point. Cerbos is required by production validation.
GURU_PDP_MODE=local
# GURU_PDP_MODE=cerbos
# GURU_CERBOS_URL=http://127.0.0.1:3592
# GURU_CERBOS_POLICY_VERSION=guru-cerbos-v1
# GURU_CERBOS_TIMEOUT_SECONDS=1.5
# GURU_CERBOS_REQUIRE_FRESH=true

# Control-plane retention and optional redaction-safe telemetry export.
GURU_AUDIT_FAIL_CLOSED=false
GURU_AUDIT_RETENTION_DAYS=365
# GURU_OTEL_EXPORTER_ENDPOINT=https://<internal-collector>/v1/traces
# GURU_OTEL_EXPORTER_TIMEOUT_SECONDS=2

# Optional trusted LMS edge adapter. Roles/capabilities are derived from the
# authenticated edge response, never from browser-supplied headers.
# GURU_EDGE_ADAPTER=openedx
# GURU_EDGE_ADAPTER_BASE_URL=https://<institution-edge>
# GURU_EDGE_ADAPTER_AUTH_TOKEN=<server-side-secret>
# GURU_AGENT_GATEWAY_URL=https://<allowlisted-agent-gateway>
# GURU_OPENFGA_URL=https://<openfga>
# GURU_LIVEKIT_URL=https://<livekit>

# Optional public-web research. Disabled by default; only configured official
# domains are searched and fetched, and returned content remains untrusted data.
# GURU_WEB_SEARCH_PROVIDER=tavily
# GURU_WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
# GURU_WEB_SEARCH_API_KEY=<server-side-secret>
# GURU_WEB_SEARCH_TIMEOUT_SECONDS=8
# GURU_WEB_SEARCH_MAX_RESULTS=5
# GURU_WEB_EXTRACT_TIMEOUT_SECONDS=8
# GURU_WEB_EXTRACT_MAX_BYTES=1000000
# GURU_WEB_ALLOWED_DOMAINS=india.gov.in,education.gov.in,ugc.gov.in,aicte-india.org

# Production requirements (all external values are deployment-managed secrets/config):
# GURU_ENVIRONMENT=production
# GURU_DEV_BEARER_TOKEN=<unused-by-production-auth; do not use the default>
# CONTROL_DATABASE_URL=postgresql://<user>:<password>@<private-host>/<database>
# GURU_ALLOWED_ORIGINS=https://<approved-browser-origin>
# GURU_OIDC_ISSUER_URL=https://<issuer>/
# GURU_OIDC_AUDIENCE=guru-ji-api
# GURU_OIDC_JWKS_URL=https://<issuer>/.well-known/jwks.json
# GURU_OIDC_ALGORITHMS=RS256
# GURU_MODEL_PROVIDER=litellm
# GURU_LITELLM_MODEL_ID=<approved-model>
# GURU_LITELLM_API_KEY=<server-side-secret>
# GURU_ENABLE_DEMO_DATA=false
# GURU_PDP_MODE=cerbos
# GURU_CERBOS_URL=https://<private-cerbos>
# GURU_INSTITUTION_CONNECTOR_BASE_URL=https://<private-connector>
# GURU_INSTITUTION_CONNECTOR_AUTH_TOKEN=<server-side-secret>
# GURU_CONNECTOR_SCOPE_ATTESTATION_REQUIRED=true
# GURU_AUDIT_FAIL_CLOSED=true

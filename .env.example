# Local development defaults
GURU_APP_NAME=guru-ji-api
GURU_VERSION=0.1.0
GURU_ENVIRONMENT=development
GURU_DEV_BEARER_TOKEN=dev-token
CONTROL_DATABASE_URL=sqlite:///./data/guru_ji.db
GURU_ALLOWED_ORIGINS=http://localhost:5173
GURU_MAX_REQUEST_BYTES=1000000
GURU_REQUEST_TIMEOUT_SECONDS=30
GURU_RATE_LIMIT_REQUESTS=120
GURU_RATE_LIMIT_WINDOW_SECONDS=60

# Provider: deterministic is safe for local tests; Ollama/LiteLLM are explicit alternatives.
GURU_MODEL_PROVIDER=deterministic
# GURU_MODEL_PROVIDER=ollama
# GURU_OLLAMA_BASE_URL=http://127.0.0.1:11434
# GURU_OLLAMA_MODEL_ID=llama3.1:8b
# GURU_MODEL_PROVIDER=litellm
# GURU_LITELLM_MODEL_ID=openai/<model>
# GURU_LITELLM_BASE_URL=https://<approved-gateway>/v1
# GURU_LITELLM_API_KEY=<server-side-secret>
# Claude through the official Anthropic SDK (install the `anthropic` extra; the
# API image includes it). Voice and chat answers run at GURU_ANTHROPIC_EFFORT;
# the agent planner, which decides actions when GURU_AGENT_PLANNER=model, runs
# at GURU_ANTHROPIC_PLANNER_EFFORT. Effort: low | medium | high | xhigh | max.
# Without GURU_ANTHROPIC_API_KEY the SDK reads ANTHROPIC_API_KEY.
# GURU_MODEL_PROVIDER=anthropic
# GURU_ANTHROPIC_MODEL_ID=claude-opus-5
# GURU_ANTHROPIC_API_KEY=<server-side-secret>
# GURU_ANTHROPIC_EFFORT=low
# GURU_ANTHROPIC_PLANNER_EFFORT=medium
# Or Claude in Amazon Bedrock, with the same model and effort settings (the
# model ID gains Bedrock's `anthropic.` prefix). Requests are signed with the
# AWS credential chain, such as the ECS task role, which needs
# bedrock-mantle:CreateInference; AWS_BEARER_TOKEN_BEDROCK also works. The
# account must have access to the model in the Bedrock console first.
# GURU_MODEL_PROVIDER=bedrock
# GURU_BEDROCK_REGION=ap-south-1   (defaults to AWS_REGION)
# Every model call, planner included, must finish within this many seconds or
# the deterministic answer or plan is used instead.
GURU_MODEL_TIMEOUT_SECONDS=8
GURU_MODEL_MAX_TOKENS=800

# Local demo source is on by default. For connector-stack testing, disable it
# and point the API at the authenticated connector service.
GURU_ENABLE_DEMO_DATA=true
# GURU_INSTITUTION_CONNECTOR_BASE_URL=http://127.0.0.1:8010
# GURU_INSTITUTION_CONNECTOR_SOURCE_ID=college_a_remote
# GURU_INSTITUTION_CONNECTOR_INSTITUTION_ID=college_a
# GURU_INSTITUTION_CONNECTOR_DISPLAY_NAME=College A connector
# GURU_INSTITUTION_CONNECTOR_AUTH_TOKEN=<server-side-secret>
# For multiple colleges, use a deployment-managed JSON registry. Each
# auth_token_env value names a separate secret-manager/environment reference;
# token values must never be placed in this JSON.
# GURU_INSTITUTION_CONNECTORS=[{"source_id":"college_a_remote","institution_id":"college_a","display_name":"College A connector","base_url":"https://<college-a-connector>","auth_token_env":"COLLEGE_A_CONNECTOR_TOKEN","scope_attestation_required":true},{"source_id":"college_b_remote","institution_id":"college_b","display_name":"College B connector","base_url":"https://<college-b-connector>","auth_token_env":"COLLEGE_B_CONNECTOR_TOKEN","scope_attestation_required":true}]
# COLLEGE_A_CONNECTOR_TOKEN=<server-side-secret>
# COLLEGE_B_CONNECTOR_TOKEN=<server-side-secret>
# GURU_CONNECTOR_TIMEOUT_SECONDS=5
# GURU_CONNECTOR_MAX_RESPONSE_BYTES=1000000
# GURU_CONNECTOR_SCOPE_ATTESTATION_REQUIRED=true

# Policy decision point. Cerbos is required by production validation.
GURU_PDP_MODE=local
# GURU_PDP_MODE=cerbos
# GURU_CERBOS_URL=http://127.0.0.1:3592
# GURU_CERBOS_POLICY_VERSION=guru-cerbos-v1
# GURU_CERBOS_TIMEOUT_SECONDS=1.5
# GURU_CERBOS_REQUIRE_FRESH=true

# Control-plane retention and optional redaction-safe telemetry export.
GURU_AUDIT_FAIL_CLOSED=false
GURU_AUDIT_RETENTION_DAYS=365
# GURU_OTEL_EXPORTER_ENDPOINT=https://<internal-collector>/v1/traces
# GURU_OTEL_EXPORTER_TIMEOUT_SECONDS=2

# Optional trusted LMS edge adapter. Roles/capabilities are derived from the
# authenticated edge response, never from browser-supplied headers.
# GURU_EDGE_ADAPTER=openedx
# GURU_EDGE_ADAPTER_BASE_URL=https://<institution-edge>
# GURU_EDGE_ADAPTER_AUTH_TOKEN=<server-side-secret>
# GURU_AGENT_GATEWAY_URL=https://<allowlisted-agent-gateway>
# GURU_OPENFGA_URL=https://<openfga>
# GURU_LIVEKIT_URL=https://<livekit>

# Optional public-web research. Disabled by default; only configured official
# domains are searched and fetched, and returned content remains untrusted data.
# GURU_WEB_SEARCH_PROVIDER=tavily
# GURU_WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
# GURU_WEB_SEARCH_API_KEY=<server-side-secret>
# GURU_WEB_SEARCH_TIMEOUT_SECONDS=8
# GURU_WEB_SEARCH_MAX_RESULTS=5
# GURU_WEB_EXTRACT_TIMEOUT_SECONDS=8
# GURU_WEB_EXTRACT_MAX_BYTES=1000000
# GURU_WEB_ALLOWED_DOMAINS=india.gov.in,education.gov.in,ugc.gov.in,aicte-india.org

# Institutional data platform: ingestion, canonical database, agents, documents,
# internet intelligence. Defaults keep everything local and dependency-free.
# On by default outside production; production is opt-in (defaults to false there)
# and must set GURU_PLATFORM_ENABLED=true together with the PostgreSQL, S3 and
# queue settings below, otherwise startup validation fails.
GURU_PLATFORM_ENABLED=true
# Browser apps: the client assistant is always served at /. The developer
# platform console at /console/ is served by default outside production and is
# off in production unless set to true (serve it where clients do not reach).
GURU_WEB_CONSOLE_ENABLED=true
# Canonical institution data. Defaults to a local SQLite file (or the control
# PostgreSQL database when CONTROL_DATABASE_URL is PostgreSQL). Production uses
# PostgreSQL with row-level security bound to app.institution_id.
# INSTITUTION_DATABASE_URL=postgresql://<user>:<password>@<private-host>/<database>
GURU_OBJECT_STORE=local
GURU_OBJECT_STORE_PATH=./data/objects
# GURU_OBJECT_STORE=s3
# GURU_S3_BUCKET=<bucket>
# GURU_S3_REGION=ap-south-1
# GURU_S3_PREFIX=guru-ji
# inline runs jobs in-process right away; thread runs them on a background thread;
# sqs publishes to a queue drained by `make worker`.
GURU_JOB_QUEUE=inline
# GURU_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>
# Workers heartbeat every 30 seconds while running a job; a running job whose
# heartbeat is older than this lost its worker and is returned to the queue.
GURU_JOB_STALE_SECONDS=180
GURU_MAX_UPLOAD_BYTES=25000000
GURU_INGESTION_MAX_ROWS=50000
GURU_INGESTION_AUTO_COMMIT=true
GURU_MAPPING_CONFIDENCE_THRESHOLD=0.8
# OCR for scans and images: disabled | tesseract (binary on PATH) | textract (AWS).
GURU_OCR_ENGINE=disabled
# Email delivery for the action agent: outbox (recorded only) | smtp | ses.
GURU_EMAIL_PROVIDER=outbox
# GURU_EMAIL_SENDER=assistant@<institution-domain>
# GURU_SMTP_HOST=smtp.<provider>
# GURU_SMTP_PORT=587
# GURU_SMTP_USERNAME=<server-side-secret>
# GURU_SMTP_PASSWORD=<server-side-secret>
# Institutional domains the agent may email besides directory entries.
# GURU_EMAIL_ALLOWED_DOMAINS=college-a.example
# Document embeddings: hashing (local, no network) | ollama | openai_compatible.
GURU_EMBEDDING_PROVIDER=hashing
# GURU_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# GURU_EMBEDDING_MODEL_ID=nomic-embed-text
# Internet intelligence uses the same Tavily key as public-web research but
# searches the open web with entity resolution and robots-aware fetching.
GURU_INTELLIGENCE_SEARCH_PROVIDER=disabled
# GURU_INTELLIGENCE_SEARCH_PROVIDER=tavily
GURU_INTELLIGENCE_FETCH_PAGES=true
GURU_INTELLIGENCE_MAX_QUERIES=8
GURU_INTELLIGENCE_RESULTS_PER_QUERY=5
# Live investigations one person may run per day (managers get three times this).
GURU_INTELLIGENCE_INVESTIGATIONS_PER_DAY=20
# How site owners reach whoever runs this crawler (https URL or email); it is
# sent in the crawler's User-Agent. Required in production whenever the map or
# the search provider is on; development may leave it empty.
# GURU_INTELLIGENCE_CRAWLER_CONTACT=https://<operator-domain>/crawler
# The internet map (entities, graded accounts, evidence log, ground truth).
# Off by default; in production it needs a suppression key of 32+ characters,
# used to fingerprint personal accounts that must never enter the map.
GURU_INTELLIGENCE_MAP_ENABLED=false
# GURU_INTELLIGENCE_SUPPRESSION_KEY=<server-side-secret, 32+ characters>
# Which sweep groups are each institution's own (JSON). Importing only those
# needs no approval; any other group, every group or a custom file does.
# GURU_INTELLIGENCE_SEED_GROUPS={"bgscet": ["BGSCET"]}
# Every other group's entities belong to that group, not the institution: its
# managers can only dismiss review items about them (which of the Swamiji's
# accounts is real is for the Math or trust IT office to say). Name who may
# decide for each such group (JSON of sweep group to principal IDs).
# GURU_INTELLIGENCE_ENTITY_APPROVERS={"Mutt & Swamiji": ["math-it-office"]}
# Where incidents on those groups' sites and accounts are emailed (JSON of
# sweep group to addresses; their domains must be in GURU_EMAIL_ALLOWED_DOMAINS).
# Without an entry they reach only the institution's alert recipients, marked
# for that group's IT office, never the institution's own security contacts.
# GURU_INTELLIGENCE_AUTHORITY_CONTACTS={"Mutt & Swamiji": ["it@adichunchanagiri.org"]}
# The map engine's daily caps per budget (JSON; unset keys keep their defaults),
# the share of each cap one institution may spend, and sources per tick.
# GURU_INTELLIGENCE_BUDGETS={"fetch": 3000, "search": 100}
GURU_INTELLIGENCE_TENANT_SHARE=0.5
GURU_INTELLIGENCE_SOURCES_PER_TICK=25
# Optional connectors, all off unless listed: search, spam_probe, feed, youtube,
# wikidata, court_records, certificates, rdap, dns, wayback, link_hub, directory,
# openstreetmap, google_play (app listings), google_play_search (new apps through
# the search index), news_feed (English and Kannada news RSS, daily) and
# lookalike_domains (similar names registered, sent for review).
# search/spam_probe/google_play_search need the search provider; youtube and
# court_records need keys. openstreetmap needs GURU_INTELLIGENCE_CRAWLER_CONTACT:
# Nominatim's usage policy asks for a contact; the map waits 15 seconds between
# requests and re-reads a place by its ID once a month. Data from it is
# © OpenStreetMap contributors (ODbL) and is attributed where it is shown.
GURU_INTELLIGENCE_CONNECTORS=
# GURU_INTELLIGENCE_YOUTUBE_API_KEY=<YouTube Data API key>
# GURU_INTELLIGENCE_INDIANKANOON_TOKEN=<IndianKanoon API token>
# How long intelligence data is kept, 30 to 3650 days (India's DPDP Act: no
# longer than its purpose needs). Monitoring documents, events, runs and
# reports go after this; so do the map's decided review items, resolved
# incidents, runs and superseded observations, while the evidence grades rest
# on stays with its free text blanked. Quota rows go after 30 days at most.
# Applied at start-up and with each daily map digest.
GURU_INTELLIGENCE_RETENTION_DAYS=365
# Certificate transparency (certificates, lookalike_domains) uses SSLMate's Cert
# Spotter API, free without a key at a low rate; a key raises the limit.
# GURU_INTELLIGENCE_CERTSPOTTER_TOKEN=<Cert Spotter API key>
# deterministic planner works without a model; model planner needs GURU_MODEL_PROVIDER.
GURU_AGENT_PLANNER=deterministic
GURU_APPROVAL_TTL_SECONDS=900
# assistant keeps voice on the read-only path; agent lets voice perform work.
GURU_VOICE_AGENT_MODE=assistant

# Two-way voice conversation. The browser turns speech into text (Web Speech
# API); only the text reaches the server. A session stays open while the person
# keeps talking and ends after the idle timeout or the maximum length. Sessions
# live in the control database, so any API task can serve the WebSocket.
GURU_VOICE_SESSION_MAX_SECONDS=1800
GURU_VOICE_IDLE_TIMEOUT_SECONDS=180
GURU_VOICE_TICKET_TTL_SECONDS=60
GURU_VOICE_MAX_ACTIVE_SESSIONS=50
GURU_VOICE_MAX_SESSIONS_PER_PERSON=2
GURU_VOICE_UTTERANCES_PER_MINUTE=20
# Spoken replies. browser = the device's own voices (an en-IN/hi-IN/kn-IN voice
# is chosen when the device has one). polly = Amazon Polly's Kajal (neural,
# Indian English and Hindi; neural voices are available in ap-south-1): the ECS
# task role needs polly:SynthesizeSpeech. Polly has no Kannada voice, so Kannada
# replies use the device's voice or are shown as text. Any Polly failure falls
# back to the browser voice for that sentence.
GURU_VOICE_TTS_PROVIDER=browser
# GURU_VOICE_TTS_PROVIDER=polly
# GURU_VOICE_POLLY_VOICE_ID=Kajal
# GURU_VOICE_POLLY_ENGINE=neural
# GURU_VOICE_POLLY_REGION=ap-south-1   (defaults to AWS_REGION)
# GURU_VOICE_TTS_TIMEOUT_SECONDS=4
# GURU_VOICE_TTS_MAX_CONCURRENCY=8
# Speech per reply is capped (the rest stays on screen), which bounds Polly cost.
# GURU_VOICE_TTS_MAX_CHARS_PER_REPLY=1500

# Free conversation: greetings, general questions and follow-ups get a real
# reply (from GURU_MODEL_PROVIDER) instead of "could not map this request";
# institutional figures still come only from the tools. Replies follow the
# language spoken (Indian English, Hindi, Hinglish, Kannada).
GURU_CONVERSATION_ENABLED=true
# Typed chat waits this long for a whole reply.
GURU_CONVERSATION_TIMEOUT_SECONDS=8
# Spoken replies are streamed: each sentence is spoken as soon as the model has
# written it. The first text must come within FIRST_TEXT seconds and the whole
# reply within STREAM seconds; a reply that fails after speaking has started is
# withdrawn and a standard reply is spoken instead.
GURU_CONVERSATION_FIRST_TEXT_SECONDS=6
GURU_CONVERSATION_STREAM_SECONDS=20
# Say a short "one moment" when nothing has been said this long after the person
# stopped talking (0 turns it off).
GURU_VOICE_FILLER_AFTER_MS=1800
# A faster Claude model for conversational turns (the answer model otherwise).
# GURU_CONVERSATION_MODEL_ID=<claude-model-id>

# Open-web search by voice or text ("search the internet for ...", "latest news
# on ..."). Uses the GURU_WEB_SEARCH_PROVIDER=tavily settings above, searches
# the whole web (not the research allowlist), shows cited sources, treats every
# result as untrusted, refuses queries carrying personal data, and allows each
# person this many searches a day (India time). Needs the web:search capability
# (every role has it; an identity provider sending explicit guru_capabilities
# must include it).
GURU_ASSISTANT_WEB_SEARCH=true
GURU_WEB_SEARCHES_PER_PERSON_PER_DAY=25
# GURU_ASSISTANT_WEB_EXCLUDE_DOMAINS=example-spam.com,another.example

# Production requirements (all external values are deployment-managed secrets/config):
# GURU_ENVIRONMENT=production
# GURU_DEV_BEARER_TOKEN=<unused-by-production-auth; do not use the default>
# CONTROL_DATABASE_URL=postgresql://<user>:<password>@<private-host>/<database>
# GURU_ALLOWED_ORIGINS=https://<approved-browser-origin>
# Register https://<host>/ (assistant) and, if the console is served,
# https://<host>/console/ as OIDC callback and sign-out URLs.
# GURU_OIDC_ISSUER_URL=https://<issuer>/
# GURU_OIDC_AUDIENCE=guru-ji-api
# GURU_OIDC_JWKS_URL=https://<issuer>/.well-known/jwks.json
# GURU_OIDC_ALGORITHMS=RS256
# GURU_MODEL_PROVIDER=litellm
# GURU_LITELLM_MODEL_ID=<approved-model>
# GURU_LITELLM_API_KEY=<server-side-secret>
# or Claude: GURU_MODEL_PROVIDER=anthropic and GURU_ANTHROPIC_API_KEY=<server-side-secret>
# GURU_ENABLE_DEMO_DATA=false
# GURU_PDP_MODE=cerbos
# GURU_CERBOS_URL=https://<private-cerbos>
# GURU_INSTITUTION_CONNECTOR_BASE_URL=https://<private-connector>
# GURU_INSTITUTION_CONNECTOR_AUTH_TOKEN=<server-side-secret>
# Alternatively use GURU_INSTITUTION_CONNECTORS above for multiple colleges.
# GURU_CONNECTOR_SCOPE_ATTESTATION_REQUIRED=true
# GURU_AUDIT_FAIL_CLOSED=true
# The data platform is off in production unless explicitly enabled; when enabled
# all of the following are required.
# GURU_PLATFORM_ENABLED=true
# INSTITUTION_DATABASE_URL=postgresql://<user>:<password>@<private-host>/<database>
# GURU_OBJECT_STORE=s3
# GURU_S3_BUCKET=<bucket>
# GURU_JOB_QUEUE=sqs
# GURU_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>

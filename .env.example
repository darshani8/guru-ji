# Local development defaults
# Names from before the rename from Guru Ji (GURU_*) are still accepted: each is
# copied to its SAFFRON_* name when that is unset, so a SAFFRON_* value wins.
# Use SAFFRON_* for new configuration.
SAFFRON_APP_NAME=agentic-saffron-api
SAFFRON_VERSION=0.1.0
SAFFRON_ENVIRONMENT=development
SAFFRON_DEV_BEARER_TOKEN=dev-token
CONTROL_DATABASE_URL=sqlite:///./data/agentic_saffron.db
SAFFRON_ALLOWED_ORIGINS=http://localhost:5173
SAFFRON_MAX_REQUEST_BYTES=1000000
SAFFRON_REQUEST_TIMEOUT_SECONDS=30
SAFFRON_RATE_LIMIT_REQUESTS=120
SAFFRON_RATE_LIMIT_WINDOW_SECONDS=60

# Provider: deterministic is safe for local tests; Ollama/LiteLLM are explicit alternatives.
SAFFRON_MODEL_PROVIDER=deterministic
# SAFFRON_MODEL_PROVIDER=ollama
# SAFFRON_OLLAMA_BASE_URL=http://127.0.0.1:11434
# SAFFRON_OLLAMA_MODEL_ID=llama3.1:8b
# SAFFRON_MODEL_PROVIDER=litellm
# SAFFRON_LITELLM_MODEL_ID=openai/<model>
# SAFFRON_LITELLM_BASE_URL=https://<approved-gateway>/v1
# SAFFRON_LITELLM_API_KEY=<server-side-secret>
# Claude through the official Anthropic SDK (install the `anthropic` extra; the
# API image includes it). Voice and chat answers run at SAFFRON_ANTHROPIC_EFFORT;
# the agent planner, which decides actions when SAFFRON_AGENT_PLANNER=model, runs
# at SAFFRON_ANTHROPIC_PLANNER_EFFORT. Effort: low | medium | high | xhigh | max.
# Without SAFFRON_ANTHROPIC_API_KEY the SDK reads ANTHROPIC_API_KEY.
# SAFFRON_MODEL_PROVIDER=anthropic
# SAFFRON_ANTHROPIC_MODEL_ID=claude-opus-5
# SAFFRON_ANTHROPIC_API_KEY=<server-side-secret>
# SAFFRON_ANTHROPIC_EFFORT=low
# SAFFRON_ANTHROPIC_PLANNER_EFFORT=medium
# Or Claude in Amazon Bedrock, with the same model and effort settings (the
# model ID gains Bedrock's `anthropic.` prefix). Requests are signed with the
# AWS credential chain, such as the ECS task role, which needs
# bedrock-mantle:CreateInference; AWS_BEARER_TOKEN_BEDROCK also works. The
# account must have access to the model in the Bedrock console first. Claude
# Haiku 4.5 (anthropic.claude-haiku-4-5), the fastest choice for voice, takes no
# effort setting, so none is sent to it.
# SAFFRON_MODEL_PROVIDER=bedrock
# SAFFRON_BEDROCK_REGION=ap-south-1   (defaults to AWS_REGION)
# Every model call, planner included, must finish within this many seconds or
# the deterministic answer or plan is used instead.
SAFFRON_MODEL_TIMEOUT_SECONDS=8
SAFFRON_MODEL_MAX_TOKENS=800

# Local demo source is on by default. For connector-stack testing, disable it
# and point the API at the authenticated connector service.
SAFFRON_ENABLE_DEMO_DATA=true
# SAFFRON_INSTITUTION_CONNECTOR_BASE_URL=http://127.0.0.1:8010
# SAFFRON_INSTITUTION_CONNECTOR_SOURCE_ID=college_a_remote
# SAFFRON_INSTITUTION_CONNECTOR_INSTITUTION_ID=college_a
# SAFFRON_INSTITUTION_CONNECTOR_DISPLAY_NAME=College A connector
# SAFFRON_INSTITUTION_CONNECTOR_AUTH_TOKEN=<server-side-secret>
# For multiple colleges, use a deployment-managed JSON registry. Each
# auth_token_env value names a separate secret-manager/environment reference;
# token values must never be placed in this JSON.
# SAFFRON_INSTITUTION_CONNECTORS=[{"source_id":"college_a_remote","institution_id":"college_a","display_name":"College A connector","base_url":"https://<college-a-connector>","auth_token_env":"COLLEGE_A_CONNECTOR_TOKEN","scope_attestation_required":true},{"source_id":"college_b_remote","institution_id":"college_b","display_name":"College B connector","base_url":"https://<college-b-connector>","auth_token_env":"COLLEGE_B_CONNECTOR_TOKEN","scope_attestation_required":true}]
# COLLEGE_A_CONNECTOR_TOKEN=<server-side-secret>
# COLLEGE_B_CONNECTOR_TOKEN=<server-side-secret>
# SAFFRON_CONNECTOR_TIMEOUT_SECONDS=5
# SAFFRON_CONNECTOR_MAX_RESPONSE_BYTES=1000000
# SAFFRON_CONNECTOR_SCOPE_ATTESTATION_REQUIRED=true

# Policy decision point. Cerbos is required by production validation.
SAFFRON_PDP_MODE=local
# SAFFRON_PDP_MODE=cerbos
# SAFFRON_CERBOS_URL=http://127.0.0.1:3592
# SAFFRON_CERBOS_POLICY_VERSION=guru-cerbos-v1
# SAFFRON_CERBOS_TIMEOUT_SECONDS=1.5
# SAFFRON_CERBOS_REQUIRE_FRESH=true

# Control-plane retention and optional redaction-safe telemetry export.
SAFFRON_AUDIT_FAIL_CLOSED=false
SAFFRON_AUDIT_RETENTION_DAYS=365
# SAFFRON_OTEL_EXPORTER_ENDPOINT=https://<internal-collector>/v1/traces
# SAFFRON_OTEL_EXPORTER_TIMEOUT_SECONDS=2

# Optional trusted LMS edge adapter. Roles/capabilities are derived from the
# authenticated edge response, never from browser-supplied headers.
# SAFFRON_EDGE_ADAPTER=openedx
# SAFFRON_EDGE_ADAPTER_BASE_URL=https://<institution-edge>
# SAFFRON_EDGE_ADAPTER_AUTH_TOKEN=<server-side-secret>
# SAFFRON_AGENT_GATEWAY_URL=https://<allowlisted-agent-gateway>
# SAFFRON_OPENFGA_URL=https://<openfga>
# SAFFRON_LIVEKIT_URL=https://<livekit>

# Optional public-web research. Disabled by default; only configured official
# domains are searched and fetched, and returned content remains untrusted data.
# SAFFRON_WEB_SEARCH_PROVIDER=tavily
# SAFFRON_WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
# SAFFRON_WEB_SEARCH_API_KEY=<server-side-secret>
# SAFFRON_WEB_SEARCH_TIMEOUT_SECONDS=8
# SAFFRON_WEB_SEARCH_MAX_RESULTS=5
# SAFFRON_WEB_EXTRACT_TIMEOUT_SECONDS=8
# SAFFRON_WEB_EXTRACT_MAX_BYTES=1000000
# SAFFRON_WEB_ALLOWED_DOMAINS=india.gov.in,education.gov.in,ugc.gov.in,aicte-india.org

# Institutional data platform: ingestion, canonical database, agents, documents,
# internet intelligence. Defaults keep everything local and dependency-free.
# On by default outside production; production is opt-in (defaults to false there)
# and must set SAFFRON_PLATFORM_ENABLED=true together with the PostgreSQL, S3 and
# queue settings below, otherwise startup validation fails.
SAFFRON_PLATFORM_ENABLED=true
# Browser apps: the client assistant is always served at /. The developer
# platform console at /console/ is served by default outside production and is
# off in production unless set to true (serve it where clients do not reach).
SAFFRON_WEB_CONSOLE_ENABLED=true
# Canonical institution data. Defaults to a local SQLite file (or the control
# PostgreSQL database when CONTROL_DATABASE_URL is PostgreSQL). Production uses
# PostgreSQL with row-level security bound to app.institution_id.
# INSTITUTION_DATABASE_URL=postgresql://<user>:<password>@<private-host>/<database>
SAFFRON_OBJECT_STORE=local
SAFFRON_OBJECT_STORE_PATH=./data/objects
# SAFFRON_OBJECT_STORE=s3
# SAFFRON_S3_BUCKET=<bucket>
# SAFFRON_S3_REGION=ap-south-1
# SAFFRON_S3_PREFIX=agentic-saffron
# inline runs jobs in-process right away; thread runs them on a background thread;
# sqs publishes to a queue drained by `make worker`.
SAFFRON_JOB_QUEUE=inline
# SAFFRON_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>
# Workers heartbeat every 30 seconds while running a job; a running job whose
# heartbeat is older than this lost its worker and is returned to the queue.
SAFFRON_JOB_STALE_SECONDS=180
SAFFRON_MAX_UPLOAD_BYTES=25000000
SAFFRON_INGESTION_MAX_ROWS=50000
SAFFRON_INGESTION_AUTO_COMMIT=true
SAFFRON_MAPPING_CONFIDENCE_THRESHOLD=0.8
# OCR for scans and images: disabled | tesseract (binary on PATH) | textract (AWS).
SAFFRON_OCR_ENGINE=disabled
# Email delivery for the action agent: outbox (recorded only) | smtp | ses.
SAFFRON_EMAIL_PROVIDER=outbox
# SAFFRON_EMAIL_SENDER=assistant@<institution-domain>
# SAFFRON_SMTP_HOST=smtp.<provider>
# SAFFRON_SMTP_PORT=587
# SAFFRON_SMTP_USERNAME=<server-side-secret>
# SAFFRON_SMTP_PASSWORD=<server-side-secret>
# Institutional domains the agent may email besides directory entries.
# SAFFRON_EMAIL_ALLOWED_DOMAINS=college-a.example
# Document embeddings: hashing (local, no network) | ollama | openai_compatible.
SAFFRON_EMBEDDING_PROVIDER=hashing
# SAFFRON_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# SAFFRON_EMBEDDING_MODEL_ID=nomic-embed-text
# Internet intelligence uses the same Tavily key as public-web research but
# searches the open web with entity resolution and robots-aware fetching.
SAFFRON_INTELLIGENCE_SEARCH_PROVIDER=disabled
# SAFFRON_INTELLIGENCE_SEARCH_PROVIDER=tavily
SAFFRON_INTELLIGENCE_FETCH_PAGES=true
SAFFRON_INTELLIGENCE_MAX_QUERIES=8
SAFFRON_INTELLIGENCE_RESULTS_PER_QUERY=5
# Live investigations one person may run per day (managers get three times this).
SAFFRON_INTELLIGENCE_INVESTIGATIONS_PER_DAY=20
# How site owners reach whoever runs this crawler (https URL or email); it is
# sent in the crawler's User-Agent. Required in production whenever the map or
# the search provider is on; development may leave it empty.
# SAFFRON_INTELLIGENCE_CRAWLER_CONTACT=https://<operator-domain>/crawler
# The internet map (entities, graded accounts, evidence log, ground truth).
# Off by default; in production it needs a suppression key of 32+ characters,
# used to fingerprint personal accounts that must never enter the map.
SAFFRON_INTELLIGENCE_MAP_ENABLED=false
# SAFFRON_INTELLIGENCE_SUPPRESSION_KEY=<server-side-secret, 32+ characters>
# Which sweep groups are each institution's own (JSON). Importing only those
# needs no approval; any other group, every group or a custom file does.
# SAFFRON_INTELLIGENCE_SEED_GROUPS={"bgscet": ["BGSCET"]}
# Every other group's entities belong to that group, not the institution: its
# managers can only dismiss review items about them (which of the Swamiji's
# accounts is real is for the Math or trust IT office to say). Name who may
# decide for each such group (JSON of sweep group to principal IDs).
# SAFFRON_INTELLIGENCE_ENTITY_APPROVERS={"Mutt & Swamiji": ["math-it-office"]}
# Where incidents on those groups' sites and accounts are emailed (JSON of
# sweep group to addresses; their domains must be in SAFFRON_EMAIL_ALLOWED_DOMAINS).
# Without an entry they reach only the institution's alert recipients, marked
# for that group's IT office, never the institution's own security contacts.
# SAFFRON_INTELLIGENCE_AUTHORITY_CONTACTS={"Mutt & Swamiji": ["it@adichunchanagiri.org"]}
# The map engine's daily caps per budget (JSON; unset keys keep their defaults),
# the share of each cap one institution may spend, and sources per tick.
# SAFFRON_INTELLIGENCE_BUDGETS={"fetch": 3000, "search": 100}
SAFFRON_INTELLIGENCE_TENANT_SHARE=0.5
SAFFRON_INTELLIGENCE_SOURCES_PER_TICK=25
# Optional connectors, all off unless listed: search, spam_probe, feed, youtube,
# wikidata, court_records, certificates, rdap, dns, wayback, link_hub, directory,
# openstreetmap, google_play (app listings), google_play_search (new apps through
# the search index), news_feed (English and Kannada news RSS, daily) and
# lookalike_domains (similar names registered, sent for review).
# search/spam_probe/google_play_search need the search provider; youtube and
# court_records need keys. openstreetmap needs SAFFRON_INTELLIGENCE_CRAWLER_CONTACT:
# Nominatim's usage policy asks for a contact; the map waits 15 seconds between
# requests and re-reads a place by its ID once a month. Data from it is
# © OpenStreetMap contributors (ODbL) and is attributed where it is shown.
SAFFRON_INTELLIGENCE_CONNECTORS=
# SAFFRON_INTELLIGENCE_YOUTUBE_API_KEY=<YouTube Data API key>
# SAFFRON_INTELLIGENCE_INDIANKANOON_TOKEN=<IndianKanoon API token>
# How long intelligence data is kept, 30 to 3650 days (India's DPDP Act: no
# longer than its purpose needs). Monitoring documents, events, runs and
# reports go after this; so do the map's decided review items, resolved
# incidents, runs and superseded observations, while the evidence grades rest
# on stays with its free text blanked. Quota rows go after 30 days at most.
# Applied at start-up and with each daily map digest.
SAFFRON_INTELLIGENCE_RETENTION_DAYS=365
# Certificate transparency (certificates, lookalike_domains) uses SSLMate's Cert
# Spotter API, free without a key at a low rate; a key raises the limit.
# SAFFRON_INTELLIGENCE_CERTSPOTTER_TOKEN=<Cert Spotter API key>
# deterministic planner works without a model; model planner needs SAFFRON_MODEL_PROVIDER.
SAFFRON_AGENT_PLANNER=deterministic
SAFFRON_APPROVAL_TTL_SECONDS=900
# assistant keeps voice on the read-only path; agent lets voice perform work.
SAFFRON_VOICE_AGENT_MODE=assistant

# Two-way voice conversation. The browser turns speech into text (Web Speech
# API); only the text reaches the server. A session stays open while the person
# keeps talking and ends after the idle timeout or the maximum length. Sessions
# live in the control database, so any API task can serve the WebSocket.
SAFFRON_VOICE_SESSION_MAX_SECONDS=1800
SAFFRON_VOICE_IDLE_TIMEOUT_SECONDS=180
SAFFRON_VOICE_TICKET_TTL_SECONDS=60
SAFFRON_VOICE_MAX_ACTIVE_SESSIONS=50
SAFFRON_VOICE_MAX_SESSIONS_PER_PERSON=2
SAFFRON_VOICE_UTTERANCES_PER_MINUTE=20
# Spoken replies. browser = the device's own voices (an en-IN/hi-IN/kn-IN voice
# is chosen when the device has one). polly = Amazon Polly's Kajal (neural,
# Indian English and Hindi; neural voices are available in ap-south-1): the ECS
# task role needs polly:SynthesizeSpeech. Polly has no Kannada voice, so Kannada
# replies use the device's voice or are shown as text. Any Polly failure falls
# back to the browser voice for that sentence.
SAFFRON_VOICE_TTS_PROVIDER=browser
# SAFFRON_VOICE_TTS_PROVIDER=polly
# SAFFRON_VOICE_POLLY_VOICE_ID=Kajal
# SAFFRON_VOICE_POLLY_ENGINE=neural
# SAFFRON_VOICE_POLLY_REGION=ap-south-1   (defaults to AWS_REGION)
# SAFFRON_VOICE_TTS_TIMEOUT_SECONDS=4
# SAFFRON_VOICE_TTS_MAX_CONCURRENCY=8
# Speech per reply is capped (the rest stays on screen), which bounds Polly cost.
# SAFFRON_VOICE_TTS_MAX_CHARS_PER_REPLY=1500

# Free conversation: greetings, general questions and follow-ups get a real
# reply (from SAFFRON_MODEL_PROVIDER) instead of "could not map this request";
# institutional figures still come only from the tools. Replies follow the
# language spoken (Indian English, Hindi, Hinglish, Kannada).
SAFFRON_CONVERSATION_ENABLED=true
# Typed chat waits this long for a whole reply.
SAFFRON_CONVERSATION_TIMEOUT_SECONDS=8
# Spoken replies are streamed: each sentence is spoken as soon as the model has
# written it. The first text must come within FIRST_TEXT seconds and the whole
# reply within STREAM seconds; a reply that fails after speaking has started is
# withdrawn and a standard reply is spoken instead.
SAFFRON_CONVERSATION_FIRST_TEXT_SECONDS=6
SAFFRON_CONVERSATION_STREAM_SECONDS=20
# Say a short "one moment" when nothing has been said this long after the person
# stopped talking (0 turns it off).
SAFFRON_VOICE_FILLER_AFTER_MS=1800
# Show the app's own log lines, such as one per voice turn and the browser's
# listening report (counts only, never words). Unset keeps warnings only.
# SAFFRON_LOG_LEVEL=INFO
# A faster Claude model for conversational turns (the answer model otherwise).
# SAFFRON_CONVERSATION_MODEL_ID=<claude-model-id>

# Open-web search by voice or text ("search the internet for ...", "latest news
# on ..."). Uses the SAFFRON_WEB_SEARCH_PROVIDER=tavily settings above, searches
# the whole web (not the research allowlist), shows cited sources, treats every
# result as untrusted, refuses queries carrying personal data, and allows each
# person this many searches a day (India time). Needs the web:search capability
# (every role has it; an identity provider sending explicit guru_capabilities
# must include it).
SAFFRON_ASSISTANT_WEB_SEARCH=true
SAFFRON_WEB_SEARCHES_PER_PERSON_PER_DAY=25
# SAFFRON_ASSISTANT_WEB_EXCLUDE_DOMAINS=example-spam.com,another.example

# The open-task agent. When the planner's tools cannot do a job (a presentation,
# a Word document, charts, a workbook with formulas or several sheets, a custom
# analysis or plan), Claude reads the records through the tool gateway as the
# person who asked (read-only tools only, same permissions and audit), writes and
# runs Python in a sandbox, and hands the files back as downloadable reports.
# Needs SAFFRON_MODEL_PROVIDER=anthropic or bedrock, the data platform, the
# open-task extra (uv sync --extra open-task) and the reports:generate capability.
# With a thread or SQS job queue, tasks run in the background and the person is
# notified when the files are ready.
# SAFFRON_OPEN_TASK_ENABLED=true
# SAFFRON_OPEN_TASK_MODEL_ID=claude-opus-5-5
# SAFFRON_OPEN_TASK_EFFORT=high
# SAFFRON_OPEN_TASK_TURN_TIMEOUT_SECONDS=300
# SAFFRON_OPEN_TASK_DEADLINE_SECONDS=900
# SAFFRON_OPEN_TASK_MAX_TURNS=30
# SAFFRON_OPEN_TASK_PER_PERSON_PER_DAY=10
# SAFFRON_OPEN_TASK_BACKGROUND=true
# The sandbox: isolated runs the code in its own user, network, PID and mount
# namespaces (unshare), with no network and the service's files hidden; it is
# the only mode production accepts, and the host must allow unprivileged user
# namespaces. guarded (development only) relies on an audit hook instead;
# auto picks isolated when it can.
# SAFFRON_OPEN_TASK_SANDBOX=isolated
# SAFFRON_OPEN_TASK_RUN_TIMEOUT_SECONDS=120
# SAFFRON_OPEN_TASK_MEMORY_MB=2048
# SAFFRON_OPEN_TASK_SANDBOX_DIR=/tmp
# SAFFRON_OPEN_TASK_HIDDEN_PATHS=/srv/other-data,/etc/saffron-secrets

# Production requirements (all external values are deployment-managed secrets/config):
# SAFFRON_ENVIRONMENT=production
# SAFFRON_DEV_BEARER_TOKEN=<unused-by-production-auth; do not use the default>
# CONTROL_DATABASE_URL=postgresql://<user>:<password>@<private-host>/<database>
# SAFFRON_ALLOWED_ORIGINS=https://<approved-browser-origin>
# Register https://<host>/ (assistant) and, if the console is served,
# https://<host>/console/ as OIDC callback and sign-out URLs.
# SAFFRON_OIDC_ISSUER_URL=https://<issuer>/
# SAFFRON_OIDC_AUDIENCE=agentic-saffron-api
# SAFFRON_OIDC_JWKS_URL=https://<issuer>/.well-known/jwks.json
# SAFFRON_OIDC_ALGORITHMS=RS256
# SAFFRON_MODEL_PROVIDER=litellm
# SAFFRON_LITELLM_MODEL_ID=<approved-model>
# SAFFRON_LITELLM_API_KEY=<server-side-secret>
# or Claude: SAFFRON_MODEL_PROVIDER=anthropic and SAFFRON_ANTHROPIC_API_KEY=<server-side-secret>
# SAFFRON_ENABLE_DEMO_DATA=false
# SAFFRON_PDP_MODE=cerbos
# SAFFRON_CERBOS_URL=https://<private-cerbos>
# SAFFRON_INSTITUTION_CONNECTOR_BASE_URL=https://<private-connector>
# SAFFRON_INSTITUTION_CONNECTOR_AUTH_TOKEN=<server-side-secret>
# Alternatively use SAFFRON_INSTITUTION_CONNECTORS above for multiple colleges.
# SAFFRON_CONNECTOR_SCOPE_ATTESTATION_REQUIRED=true
# SAFFRON_AUDIT_FAIL_CLOSED=true
# The data platform is off in production unless explicitly enabled; when enabled
# all of the following are required.
# SAFFRON_PLATFORM_ENABLED=true
# INSTITUTION_DATABASE_URL=postgresql://<user>:<password>@<private-host>/<database>
# SAFFRON_OBJECT_STORE=s3
# SAFFRON_S3_BUCKET=<bucket>
# SAFFRON_JOB_QUEUE=sqs
# SAFFRON_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>
